      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"未預期例外回傳 500\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "const response = pm.response.json();",
