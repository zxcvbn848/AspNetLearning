    {
      "name": "第一課：問候 API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/hello/{{name}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "hello",
            "{{name}}"
          ]
        },
        "description": "將 name 變數放入路由，預期回傳包含問候文字的 JSON。"
      },
      "response": []
    },
    {
      "name": "第二課：取得待辦清單",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "description": "呼叫 TodosController.GetAll，取得記憶體中的所有待辦事項，預期回傳 JSON 陣列。"
      },
      "response": []
    },
    {
      "name": "第三課：建立待辦事項",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"閱讀 POST API 文件\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "description": "傳送 JSON Request Body 給 TodosController.Create，預期回傳 HTTP 201 Created。"
      },
      "response": []
    },
    {
      "name": "第四課：更新待辦事項",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"認識 Controller 與 Service\",\n  \"isCompleted\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        },
        "description": "呼叫 TodosController.Update 更新指定待辦事項，預期回傳 HTTP 200 與更新後資料。"
