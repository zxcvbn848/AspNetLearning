    {
      "name": "第九課：會員註冊",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Learning123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "建立會員，預期回傳 HTTP 201 與不含密碼雜湊的會員資料。重複 Email 會回傳 HTTP 409。"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('registerEmail', pm.variables.replaceIn('{{$randomEmail}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('註冊成功回傳 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('回應不包含密碼與密碼雜湊', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).not.to.have.property('password');",
              "    pm.expect(response).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十課：會員登入",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Learning123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "使用第九課剛建立的會員登入，預期回傳 HTTP 200 與 JWT，並自動保存到 accessToken Collection Variable。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('登入成功回傳 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.test('回傳格式正確的 JWT', function () {",
              "    pm.expect(response.tokenType).to.eql('Bearer');",
              "    pm.expect(response.accessToken.split('.')).to.have.lengthOf(3);",
              "});",
              "pm.collectionVariables.set('accessToken', response.accessToken);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十八課：更新 Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "使用登入後 Postman Cookie Jar 保存的 HttpOnly Cookie 取得新的 Access Token；每次呼叫都會輪替 Cookie。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('回傳 HTTP 200', function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "pm.test('取得新 JWT', function () { pm.expect(response.accessToken.split('.')).to.have.lengthOf(3); });",
              "pm.collectionVariables.set('accessToken', response.accessToken);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十八課：登出並撤銷 Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "撤銷目前 Cookie 對應的工作階段；之後再呼叫更新端點會回傳 401。既有 JWT 在到期前仍有效。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('回傳 HTTP 204', function () { pm.response.to.have.status(204); });",
              "pm.collectionVariables.unset('accessToken');"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十一課：取得目前會員",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "使用登入後保存的 Bearer Token 取得目前會員，預期回傳 HTTP 200。缺少、無效或過期 Token 會回傳 HTTP 401。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('有效 Token 回傳 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.test('回傳登入會員且不包含密碼資料', function () {",
              "    pm.expect(response.email).to.eql(pm.collectionVariables.get('registerEmail'));",
              "    pm.expect(response).not.to.have.property('password');",
              "    pm.expect(response).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十三課：驗證失效 Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
