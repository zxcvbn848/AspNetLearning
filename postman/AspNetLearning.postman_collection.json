        "description": "使用刻意無效的 Bearer Token 呼叫受保護 API，預期回傳 HTTP 401。此請求不會覆蓋登入後保存的 accessToken。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"無效 Token 會回傳 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "第十四課：驗證錯誤 Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
