          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"Learning123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "驗證 Data Annotations 會拒絕錯誤 Email，並在 errors.Email 回傳中文訊息。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"錯誤 Email 回傳 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Email 驗證訊息正確\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.errors.Email).to.include(\"Email 格式不正確。\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
