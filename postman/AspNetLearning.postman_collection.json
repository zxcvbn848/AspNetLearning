          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        },
        "description": "呼叫 TodosController.Delete 刪除指定待辦事項，預期回傳 HTTP 204 No Content。"
