    {
      "name": "第二課：取得待辦清單",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "description": "使用 Bearer Token 取得目前登入會員自己的待辦事項，預期回傳 HTTP 200 與 JSON 陣列。",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"取得會員自己的待辦清單會回傳 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "第三課：建立待辦事項",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
